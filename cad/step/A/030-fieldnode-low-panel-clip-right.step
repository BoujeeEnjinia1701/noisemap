  '3D Context with UNIT and UNCERTAINTY') );
#770 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#771 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#772 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#773 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(2.E-07),#770,
  'distance_accuracy_value','confusion accuracy');
#774 = CONTEXT_DEPENDENT_SHAPE_REPRESENTATION(#775,#777);
#775 = ( REPRESENTATION_RELATIONSHIP('','',#32,#10) 
REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION(#776) 
SHAPE_REPRESENTATION_RELATIONSHIP() );
#776 = ITEM_DEFINED_TRANSFORMATION('','',#11,#15);
